# ==============================================================================
# .env.example - Configuración del Entorno de Bitácora E.E
# Copiar este archivo a .env y ajustar los valores según corresponda.
# ==============================================================================

# ── Django Core ───────────────────────────────────────────────────────────────
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-this-to-a-super-secret-key-in-production-min-50-chars!
ALLOWED_HOSTS=localhost,127.0.0.1,bitacora.mibus.com
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://localhost:3000

# ── Base de Datos PostgreSQL ──────────────────────────────────────────────────
DB_ENGINE=postgresql
DB_NAME=bitacora_db
DB_USER=bitacora_user
DB_PASSWORD=enterprise_password_2026
DB_HOST=postgres
DB_PORT=5432
USE_SQLITE=False

# ── Redis y Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Integración Externa: BUSAE ────────────────────────────────────────────────
BUSAE_URL=https://login.busae.com/site/login
BUSAE_DATA_URL=https://login.busae.com/live-gps-map/update-gps-map-v2
BUSAE_EMAIL=operaciones@mibus.com
BUSAE_PASSWORD=SecretPasswordBusae2026

# ── Integración Externa: Génesis JSON-RPC ─────────────────────────────────────
GENESIS_URL=http://genesis.mibus.com/tic/oi/gateway.php
GENESIS_USER=10844
GENESIS_PASSWORD=Mibus2017

# ── Sentry Error Tracking & Performance Tracing ──────────────────────────────
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ── Notificaciones y Alertas (Slack & Email) ──────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX
ALERT_EMAIL_RECIPIENTS=soporte.tecnico@mibus.com,jefe.taller@mibus.com
DEFAULT_FROM_EMAIL=alerts@bitacoraee.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=notificaciones@bitacoraee.com
EMAIL_HOST_PASSWORD=app-specific-password
EMAIL_USE_TLS=True

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
