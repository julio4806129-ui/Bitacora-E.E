# ==============================================================================
# .env — Configuración LOCAL de Desarrollo (Bitácora E.E.)
# DB_HOST=localhost  <— apunta a Docker expuesto en el host
# DJANGO_DEBUG=True  <— modo desarrollo, no requiere SECRET_KEY externo
# ==============================================================================

# Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=bitacora-ee-dev-secret-key-mibus-panama-2026-local-only!
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# PostgreSQL (expuesto por Docker en localhost:5432)
DB_ENGINE=postgresql
DB_NAME=bitacora_db
DB_USER=bitacora_user
DB_PASSWORD=enterprise_password_2026
DB_HOST=localhost
DB_PORT=5432
USE_SQLITE=False

# Redis (expuesto por Docker en localhost:6379)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Integraciones externas (placeholders para desarrollo)
BUSAE_URL=https://login.busae.com/site/login
BUSAE_DATA_URL=https://login.busae.com/live-gps-map/update-gps-map-v2
